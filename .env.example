# Copia este archivo a .env.local y completa tus datos de Auth0.
# (.env.local NO se sube a GitHub: está en .gitignore)
VITE_AUTH0_DOMAIN=tu-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=tu_client_id_de_la_aplicacion_spa

# Si es "true", la app exige que el token de Auth0 confirme MFA (claim amr = mfa).
VITE_REQUIRE_MFA=true

# Solo para mostrar la interfaz sin Auth0 (p. ej. capturas). Nunca en producción.
VITE_DEMO_MODE=false

# Comentarios: a dónde se envían (opcionales). Si no los defines, solo se puede copiar el texto.
VITE_GITHUB_REPO=tu-usuario/ciberguia-pyme
VITE_FEEDBACK_EMAIL=
